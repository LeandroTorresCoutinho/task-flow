POSTGRES_DB=task_flow
POSTGRES_USER=task_flow
POSTGRES_PASSWORD=task_flow
POSTGRES_PORT=5432

AUTH_SERVICE_PORT=8081
AUTH_DB_R2DBC_URL=r2dbc:postgresql://localhost:5432/task_flow?schema=auth_service
AUTH_DB_JDBC_URL=jdbc:postgresql://localhost:5432/task_flow
AUTH_DB_USERNAME=task_flow
AUTH_DB_PASSWORD=task_flow
AUTH_JWT_PRIVATE_KEY=file:./.secrets/jwt-private.pem
AUTH_JWT_PUBLIC_KEY=file:./.secrets/jwt-public.pem
AUTH_JWT_KEY_ID=task-flow-key-1
AUTH_JWT_ISSUER=https://task-flow.local/auth
AUTH_JWT_TTL=PT1H

TASK_SERVICE_PORT=8082
TASK_DB_R2DBC_URL=r2dbc:postgresql://localhost:5432/task_flow?schema=task_service
TASK_DB_JDBC_URL=jdbc:postgresql://localhost:5432/task_flow
TASK_DB_USERNAME=task_flow
TASK_DB_PASSWORD=task_flow
TASK_JWT_ISSUER=https://task-flow.local/auth
TASK_JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json
